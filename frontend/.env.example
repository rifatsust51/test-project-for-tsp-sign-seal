# Copy to .env.local (git-ignored) and adjust for your environment.
# All VITE_* values are compiled into the public JS bundle — never put secrets here.

# TSP gateway base URL (no trailing slash)
VITE_TSP_GATEWAY_URL=https://192.168.0.10:8443/tspgatewayservice/gateway
# Endpoint that issues the TSP admin bearer token
VITE_TSP_ADMIN_TOKEN_URL=https://192.168.0.10:8443/tspgateway/rest/admin/token
# TSP user that owns admin signatures and verification requests
VITE_TSP_ADMIN_USER_ID=66400c48-acb6-4309-ba52-24d54ad52af5
# Digital identity used for admin (organisation) signatures
VITE_TSP_ADMIN_DIGITAL_IDENTITY_ID=4d88ef87-b091-4370-807c-49625999242a
# AAS (Keycloak) client config served from public/ (optional, defaults to aas.json)
VITE_AAS_CONFIG_PATH=aas.json
